# BallR (ProspekBola) Environment Configuration

# Supabase API Credentials
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mode Demo (true | false)
# Jika false (default), aplikasi memerlukan koneksi Supabase asli dan tidak memuat mockData.js.
# Jika true, aplikasi memuat data ilustrasi lokal untuk pratinjau/pengujian tanpa database.
VITE_DEMO_MODE=false
